{
  "name": "camp",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",

  /* Tu sitio: todo lo que esté dentro de la carpeta public/ */
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  /* Variables NO secretas. Cambia por tu dirección real. */
  "vars": {
    "ALLOWED_ORIGINS": "https://camp.cfmshahahbautista.workers.dev"
  },

  "observability": { "enabled": true }
}
